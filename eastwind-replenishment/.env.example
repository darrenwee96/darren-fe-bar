DATABRICKS_HOST=https://...
DATABRICKS_WAREHOUSE_ID=your_sql_warehouse_id
PGDATABASE=your_postgres_databaseName
LAKEBASE_ENDPOINT=your_postgres_endpointPath
PGHOST=your_postgres_host
PGPORT=5432
PGSSLMODE=require
DATABRICKS_APP_PORT=8000
DATABRICKS_APP_NAME=eastwind-replenishment
FLASK_RUN_HOST=0.0.0.0
DATABRICKS_GENIE_SPACE_ID=

# Local dev identity when no proxy token is present (NODE_ENV=development only)
DEV_USER_EMAIL=
# Network-wide planners seeded into replenishment.user_scope at startup
REPLENISHMENT_ANALYSTS=
